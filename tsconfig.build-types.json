{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "checkJs": false,
        "allowJs": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "./gen/types",
        "rootDir": ".",
        "moduleResolution": "node",
        "strict": false,
        "skipLibCheck": true,
        "noEmitOnError": false,
        "incremental": true,
        "tsBuildInfoFile": "./gen/types/.tsbuildinfo",
    },
    "include": [
        "./index.d.ts",
        "shared/api/**/*",
        "shared/client/**/*",
        "cables_ui/src/**/*",
        "cables/src/core/**/*",
        "cables/src/corelibs/**/*",
    ],
    "exclude": ["node_modules", "dist"],
}
