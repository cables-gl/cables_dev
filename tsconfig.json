{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "checkJs": true,
        "allowJs": true,
        "moduleResolution": "bundler",
        "typeRoots": ["cables/node_modules/@webgpu/types", "./gen/types"],
        "strict": false,
        "paths": {
            "cables": ["./gen/types/cables/src/core/index.d.ts"],
            "cables-corelibs": ["./gen/types/cables/src/corelibs/index.d.ts"],
            "cables-corelibs/*": ["./gen/types/cables/src/corelibs/*"],
            "cables-ui": ["./gen/types/cables_ui/src/ui/*"],
            "cables-shared-api": ["./gen/types/shared/api/index.d.ts"],
            "cables-shared-client": ["./gen/types/shared/client/index.d.ts"],
        },
    },
    "include": [
        "shared/api/**/*",
        "shared/client/**/*",
        "cables_ui/src/**/*",
        "cables_ui/libs/ui/index.d.ts",
        "cables_ui/libs/ui/assets.d.ts",
        "cables/src/core/**/*",
        "cables/src/corelibs/**/*",
    ],
}
